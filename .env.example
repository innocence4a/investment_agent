# 秘密情報は .env(gitignore 済み)または環境変数で渡す。リポジトリに含めない。
ANTHROPIC_API_KEY=

# Slack Incoming Webhook(通知 F-7。未設定ならログ出力のみ)
IA_SLACK_WEBHOOK_URL=

# ダッシュボード認証トークン(N-4。未設定なら認証なし=ローカル開発用)
IA_AUTH_TOKEN=

# 主要設定(既定値。必要なら上書き)
# IA_FEED=bitflyer            # bitflyer | sim
# IA_LLM=anthropic            # anthropic | mock
# IA_TRADER_MODEL=claude-sonnet-5
# IA_DECISION_INTERVAL_SEC=300
# IA_START_CAPITAL_JPY=1000000
# IA_LLM_MONTHLY_COST_LIMIT_USD=50
# IA_PORT=8765

# Phase 1.5: 関連指標(F-18)・カレンダー(F-19)・相談役(F-21)
# IA_MACRO_SOURCE=auto        # auto | real | sim(auto は feed に追従)
# IA_MACRO_POLL_SEC=300
# IA_CALENDAR_PATH=           # 空なら core/data/economic_calendar.json
# IA_ADVISOR_HOUR_JST=7       # 相談役の日次レビュー時刻(JST)
# IA_ADVISOR_MODEL=claude-sonnet-5
# リスク管理エージェント(F-20)のしきい値
# IA_RISK_AGENT__VIX_SIZE_HALF=25
# IA_RISK_AGENT__VIX_NO_ENTRY=35
# IA_RISK_AGENT__CONSECUTIVE_LOSSES_SIZE_HALF=3
# IA_RISK_AGENT__DAILY_LOSS_WARN_RATIO=0.8
